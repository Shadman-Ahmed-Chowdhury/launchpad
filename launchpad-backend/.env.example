# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (ADR-003)
DATABASE_URL=postgres://launchpad:launchpad@localhost:5432/launchpad

# Redis — cache, Channels layer, Celery result backend (ADR-004)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ — Celery broker (ADR-005)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Frontend origin, used for CORS
FRONTEND_URL=http://localhost:3000

# Email — console backend in dev; set to SES backend in prod (ADR-006)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@launchpad.example.com

# AWS — S3 media storage (ADR-007) + SES email
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=
AWS_SES_REGION_NAME=us-east-1
